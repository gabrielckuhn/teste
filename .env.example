# Copie este arquivo para .env e preencha com os dados do seu provedor autorizado.
IPTV_BASE_URL=https://SEU_SERVIDOR
IPTV_USERNAME=SEU_USUARIO
IPTV_PASSWORD=SUA_SENHA

# URL pública onde a API FastAPI estará hospedada.
# Exemplo: https://seu-addon.exemplo.com
ADDON_PUBLIC_URL=http://127.0.0.1:8000

# Atualização/cache
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
